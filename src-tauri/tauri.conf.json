{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Berloga",
    "version":  "0.1.0",
    "identifier":  "app.berloga.desktop",
    "build":  {
                  "frontendDist":  "../shell"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "Berloga",
                                    "url":  "https://berlogaproject.vercel.app/",
                                    "width":  1180,
                                    "height":  760,
                                    "minWidth":  860,
                                    "minHeight":  560,
                                    "additionalBrowserArgs":  "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper"
                                                          },
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "Russian"
                                                              ]
                                            }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJENDVEMTc3N0ZGQzkzQzIKUldUQ2sveC9kOUZGdlVKOGMyL1V6NVNEenVlM0FRQmorZGhkNU5qSDlxQm5oRlFlNUxwZS81Qm8K",
                                    "endpoints":  [
                                                      "https://github.com/RyzoEx/Berloga/releases/latest/download/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}